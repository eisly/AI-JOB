{
  "name": "ai-job-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "verify:models": "tsc -p scripts/tsconfig.workbench-verify.json && node -e \"require('fs').writeFileSync('.workbench-verify/package.json', JSON.stringify({ type: 'commonjs' }))\" && node scripts/verify-workbench-models.cjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.8.8",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "sass": "^1.81.0",
    "typescript": "~5.6.3",
    "unplugin-auto-import": "^0.18.4",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}