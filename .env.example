# Copy to .env and set strong passwords before first startup.
# Default is local-only; change to a trusted LAN or VPN interface to share.
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=aijob
MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_password
# Redis (used for login rate limiting, access-token revocation and reset codes)
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_redis_password

# Mailpit (captures outgoing password-reset mail; open http://localhost:8025)
MAILPIT_SMTP_BIND_ADDRESS=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_BIND_ADDRESS=127.0.0.1
MAILPIT_UI_PORT=8025
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ai-job.local

# Auth: APP_JWT_SECRET must be a random string of at least 32 bytes. Never commit it.
APP_JWT_SECRET=replace_with_a_random_string_at_least_32_bytes
APP_ACCESS_TTL=900
APP_REFRESH_TTL=604800
APP_JWT_ISSUER=ai-job-business
APP_JWT_AUDIENCE=ai-job-user
APP_REFRESH_COOKIE_NAME=refresh_token
APP_REFRESH_COOKIE_PATH=/api/v1/auth
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Lax
APP_FRONTEND_ORIGIN=http://localhost:5173
APP_LOGIN_RATE_LIMIT=5
APP_LOGIN_RATE_WINDOW=60
APP_RESET_CODE_TTL=600
APP_RESET_CODE_MAX_ATTEMPTS=5
APP_RESET_CODE_COOLDOWN=60
# Local demo only: echo the reset code back in the response so it can be used without opening Mailpit.
APP_MAIL_EXPOSE_CODE=false
# AI 岗位搜索使用上方 DEEPSEEK_API_KEY；可选配置 Brave Search 作为补充。
BRAVE_SEARCH_API_KEY=
# 语音面试（Agent 侧）。ASR 使用百炼业务空间专属域名；TTS 本次仅支持 Fake，不代表真实 TTS 已完成。
# AGENT_SPEECH_ASR_PROVIDER: auto/fake/qwen；AGENT_SPEECH_TTS_PROVIDER: auto/fake（当前无真实 TTS 实现）。
# 具体 Provider 优先于兼容总开关 AGENT_SPEECH_PROVIDER；auto 时按是否有 API Key 选择 qwen/fake。
AGENT_SPEECH_PROVIDER=auto
AGENT_SPEECH_ASR_PROVIDER=fake
AGENT_SPEECH_TTS_PROVIDER=fake
SPEECH_API_KEY=
SPEECH_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com
SPEECH_ASR_MODEL=qwen-audio-3.1-asr-flash
SPEECH_TTS_MODEL=cosyvoice-v1
SPEECH_TTS_VOICE=longxiaochun
SPEECH_TIMEOUT_SECONDS=8
SPEECH_MAX_BYTES=8388608
SPEECH_CONCURRENCY=4
# Speech config: auto = dotenv in dev, environment only in prod.
# Conflicting aliases or local/environment values fail before making API calls.
# Keep one canonical SPEECH_API_KEY; do not retain stale AI_BAILIAN_API_KEY/DASHSCOPE_API_KEY.
AGENT_SPEECH_CONFIG_SOURCE=auto
